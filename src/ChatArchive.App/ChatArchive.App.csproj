<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>ChatArchive.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 自包含发布只复制实际引用组件的简体中文资源。 -->
  <Target Name="KeepOnlyZhCnWinAppSdkResources"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <_ChatArchiveMuiAll Include="%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-x64\native\**\*.mui" />
      <_ChatArchiveMuiZh Include="%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-x64\native\zh-CN\**\*.mui" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="@(_ChatArchiveMuiAll)" Exclude="@(_ChatArchiveMuiZh)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatArchive.Core\ChatArchive.Core.csproj" />
  </ItemGroup>
</Project>
