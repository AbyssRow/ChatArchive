<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChatArchive.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatArchive.App.Views"
    xmlns:vm="using:ChatArchive.App.ViewModels"
    Title="聊天档案">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Height="36" Background="Transparent">
            <TextBlock Text="聊天档案" Margin="16,0,0,0"
                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.85" />
        </Grid>

        <InfoBar x:Name="AppInfoBar" Grid.Row="1" Margin="8,0,8,4"
                 IsOpen="False" IsClosable="True" Severity="Error" />

    <NavigationView x:Name="Nav" Grid.Row="2"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    OpenPaneLength="300"
                    SelectionChanged="Nav_SelectionChanged">
        <NavigationView.Resources>
            <local:MsToDateTimeConverter x:Key="MsToDateTime" Format="yyyy-MM-dd HH:mm" />
            <local:PlatformLabelConverter x:Key="PlatformLabel" />
            <local:KindGlyphConverter x:Key="KindGlyph" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:PathToImageSourceConverter x:Key="PathToImageSource" />
            <local:CountTextConverter x:Key="CountText" />

            <DataTemplate x:Key="ConversationTemplate">
                <Grid Padding="12,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" FontSize="18"
                              Glyph="{Binding Kind, Converter={StaticResource KindGlyph}}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LastMessagePreview}" FontSize="11" Opacity="0.6"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                        <TextBlock FontSize="11" Foreground="{ThemeResource SystemAccentColor}"
                                   Text="{Binding Platform, Converter={StaticResource PlatformLabel}}" />
                        <TextBlock FontSize="10" Opacity="0.5" HorizontalAlignment="Right"
                                   Text="{Binding LastMessageAt, Converter={StaticResource MsToDateTime}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SeparatorTemplate">
                <Border HorizontalAlignment="Center" Padding="12,3" Margin="4,10,4,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.75" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="MessageBodyTemplate">
                <StackPanel Spacing="6" MaxWidth="560">
                    <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap"
                               FontSize="14" IsTextSelectionEnabled="True"
                               Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="（已撤回）" FontSize="13" Opacity="0.55"
                               Visibility="{Binding Message.IsRecalled, Converter={StaticResource BoolToVis}}"
                               FontStyle="Italic" />
                    <ItemsControl ItemsSource="{Binding Images}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ResolvedPath}" MaxHeight="220" Stretch="Uniform"
                                       Tapped="OnImageAttachmentTapped" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding OpenableAttachments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ActionText}" Click="OnAttachmentOpenClick"
                                        HorizontalAlignment="Left" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding MissingAttachments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Foreground="OrangeRed"
                                           Text="{Binding MissingText}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="IncomingTemplate">
                <Grid Margin="8,3" ColumnSpacing="8" MaxWidth="760" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,0,0"
                                   ProfilePicture="{Binding AvatarPath, Converter={StaticResource PathToImageSource}}"
                                   Initials="{Binding Initials}"
                                   DisplayName="{Binding DisplaySenderName}"
                                   Tapped="OnSenderTapped" />
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding DisplaySenderName}" FontSize="11" Opacity="0.55"
                                   Tapped="OnSenderTapped"
                                   Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4,12,12,12" Padding="10,7"
                                HorizontalAlignment="Left">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource MessageBodyTemplate}" />
                        </Border>
                        <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.4" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OutgoingTemplate">
                <Grid Margin="8,3" ColumnSpacing="8" MaxWidth="760" HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Right">
                        <Border Background="{ThemeResource SystemAccentColorLight2}"
                                CornerRadius="12,4,12,12" Padding="10,7" HorizontalAlignment="Right">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource MessageBodyTemplate}" />
                        </Border>
                        <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.4"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <PersonPicture Grid.Column="1" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,0,0"
                                   ProfilePicture="{Binding AvatarPath, Converter={StaticResource PathToImageSource}}"
                                   Initials="{Binding Initials}"
                                   DisplayName="{Binding DisplaySenderName}"
                                   Tapped="OnSenderTapped" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SystemTemplate">
                <StackPanel Margin="24,6" Spacing="2" HorizontalAlignment="Center">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="10" Padding="10,6">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource MessageBodyTemplate}" />
                    </Border>
                    <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.4"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <local:TimelineTemplateSelector x:Key="TimelineSelector"
                                            Separator="{StaticResource SeparatorTemplate}"
                                            Incoming="{StaticResource IncomingTemplate}"
                                            Outgoing="{StaticResource OutgoingTemplate}"
                                            System="{StaticResource SystemTemplate}" />
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="会话" Tag="conversations" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8BD;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="通讯录" Tag="contacts">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE779;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="搜索" Tag="search">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="统计" Tag="stats">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Button x:Name="ImportButton" Content="导入聊天记录" Margin="12,8"
                    HorizontalAlignment="Stretch" Click="OnImportClick" />
        </NavigationView.PaneFooter>

        <Grid>
            <!-- 会话面板 -->
            <Grid x:Name="TimelinePane">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="8" Padding="10,10,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ConversationQueryBox" Grid.Row="0" PlaceholderText="查找会话标题…"
                             TextChanged="ConversationQuery_TextChanged" />
                    <ComboBox x:Name="FilterCombo" Grid.Row="1" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="全部" Tag="" />
                        <ComboBoxItem Content="QQ 私聊" Tag="qq|private" />
                        <ComboBoxItem Content="QQ 群聊" Tag="qq|group" />
                        <ComboBoxItem Content="微信私聊" Tag="wechat|private" />
                        <ComboBoxItem Content="微信群聊" Tag="wechat|group" />
                    </ComboBox>
                    <ListView x:Name="ConversationListControl" Grid.Row="2"
                              ItemTemplate="{StaticResource ConversationTemplate}"
                              SelectionMode="Single"
                              SelectionChanged="ConversationList_SelectionChanged" />
                </Grid>

                <Border Grid.Column="1" Width="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Column="2" RowSpacing="6" Padding="8,10,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TimelineTitle" Grid.Row="0" FontSize="17" FontWeight="SemiBold"
                               Margin="4,0,0,4" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="LoadMoreBar" Grid.Row="1" IsIndeterminate="True"
                                 Height="4" Visibility="Collapsed" Margin="0,0,0,4" />
                    <ListView x:Name="MessageListControl" Grid.Row="2"
                              ItemTemplateSelector="{StaticResource TimelineSelector}"
                              SelectionMode="None">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel VerticalAlignment="Bottom"
                                                 ItemsUpdatingScrollMode="KeepLastItemInView" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Grid>

            <!-- 通讯录面板 -->
            <Grid x:Name="ContactsRoot" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：联系人列表与搜索/新建 -->
                <Grid Grid.Column="0" RowSpacing="8" Padding="10,10,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ContactsSearchBox" PlaceholderText="搜索联系人…"
                                 TextChanged="ContactsSearchBox_TextChanged" />
                        <Button Grid.Column="1" x:Name="NewContactButton" Content="+ 新建联系人"
                                Click="OnNewContactClick" />
                    </Grid>

                    <ProgressBar x:Name="ContactsProgressBar" Grid.Row="1" IsIndeterminate="True"
                                 Height="4" Visibility="Collapsed" />

                    <ListView x:Name="ContactsListView" Grid.Row="2"
                              SelectionMode="Single"
                              SelectionChanged="ContactsListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Grid.Column="0" Width="36" Height="36"
                                                   ProfilePicture="{Binding CustomAvatarPath, Converter={StaticResource PathToImageSource}}"
                                                   DisplayName="{Binding DisplayName}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MessageCount, Converter={StaticResource CountText}}"
                                                   FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Width="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- 右栏：联系人详情 -->
                <Grid Grid.Column="2" Padding="20,16">
                    <!-- 未选中任何联系人时的占位提示 -->
                    <TextBlock x:Name="NoContactSelectedPrompt" Text="请选择左侧联系人或点击新建"
                               FontSize="15" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- 选中联系人详情内容 -->
                    <ScrollViewer x:Name="ContactDetailPane" Visibility="Collapsed">
                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                            <!-- 基本信息卡片 -->
                            <Grid ColumnSpacing="20" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                                    <PersonPicture x:Name="DetailAvatarPicture" Width="80" Height="80" />
                                    <Button x:Name="ChangeAvatarButton" Content="更换头像" FontSize="12"
                                            HorizontalAlignment="Center" Click="OnChangeAvatarClick" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBox x:Name="DetailDisplayNameBox" Header="备注姓名" PlaceholderText="输入联系人姓名…" />
                                    <TextBox x:Name="DetailNoteBox" Header="笔记" PlaceholderText="输入笔记或备注信息…"
                                             AcceptsReturn="True" MinHeight="60" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                        <Button x:Name="SaveContactButton" Content="保存"
                                                Style="{StaticResource AccentButtonStyle}" Click="OnSaveContactClick" />
                                        <Button x:Name="DeleteContactButton" Content="删除联系人"
                                                Click="OnDeleteContactClick" />
                                        <TextBlock x:Name="DetailTotalMessagesText" VerticalAlignment="Center"
                                                   FontSize="12" Opacity="0.6" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />

                            <!-- 已绑定账号区域 -->
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="已绑定账号" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="AddBoundAccountButton" Content="+ 绑定账号"
                                            Click="OnAddBoundAccountClick" />
                                </Grid>

                                <ListView x:Name="BoundSendersListView" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,8" ColumnSpacing="12" BorderThickness="0,0,0,1"
                                                  BorderBrush="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 平台与主账号标记 -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Platform, Converter={StaticResource PlatformLabel}}" FontSize="11" />
                                                    </Border>
                                                    <Border Background="{ThemeResource SystemAccentColorLight3}" CornerRadius="4" Padding="6,2"
                                                            Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="主账号" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- 账号 ID 与原昵称 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding NativeId}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding OriginalName}" FontSize="11" Opacity="0.6" />
                                                </StackPanel>

                                                <!-- 可编辑的账号身份标签 -->
                                                <TextBox Grid.Column="2" VerticalAlignment="Center" PlaceholderText="身份标签(如工作号)"
                                                         Text="{Binding AccountLabel}" LostFocus="OnAccountLabelLostFocus" />

                                                <!-- 设为主账号按钮 -->
                                                <Button Grid.Column="3" Content="设为主账号" FontSize="12" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource InverseBool}}"
                                                        Click="OnSetPrimarySenderClick" Tag="{Binding SenderId}" />

                                                <!-- 解绑按钮 -->
                                                <Button Grid.Column="4" Content="解除绑定" FontSize="12" VerticalAlignment="Center"
                                                        Click="OnUnbindSenderClick" Tag="{Binding SenderId}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />

                            <!-- 关联会话列表 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="关联会话" FontSize="15" FontWeight="SemiBold" />
                                <ListView x:Name="ContactConversationsListView" SelectionMode="Single"
                                          IsItemClickEnabled="True" ItemClick="ContactConversation_Click">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding MessageCount, Converter={StaticResource CountText}}"
                                                           FontSize="11" Opacity="0.5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 搜索面板 -->
            <Grid x:Name="SearchPane" RowSpacing="10" Padding="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="输入关键词（≥3 字走全文索引，1-2 字自动子串匹配）"
                             KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Content="搜索" Style="{StaticResource AccentButtonStyle}"
                            Click="OnSearchClick" />
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="SearchPlatformCombo" SelectedIndex="0" MinWidth="110"
                                  SelectionChanged="SearchFilter_Changed">
                            <ComboBoxItem Content="全平台" Tag="" />
                            <ComboBoxItem Content="QQ" Tag="qq" />
                            <ComboBoxItem Content="微信" Tag="wechat" />
                        </ComboBox>
                        <ComboBox x:Name="SearchKindCombo" SelectedIndex="0" MinWidth="110"
                                  SelectionChanged="SearchFilter_Changed">
                            <ComboBoxItem Content="全部会话类型" Tag="" />
                            <ComboBoxItem Content="私聊" Tag="private" />
                            <ComboBoxItem Content="群聊" Tag="group" />
                        </ComboBox>
                        <TextBox x:Name="SearchSenderBox" PlaceholderText="发送者（可选）" MinWidth="150"
                                 KeyDown="SearchBox_KeyDown" />
                        <TextBlock x:Name="SearchModeLabel" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="SearchConversationCombo" MinWidth="220" MaxWidth="320"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedIndex="0"
                                  SelectionChanged="SearchFilter_SelectionChanged" />
                        <ComboBox x:Name="SearchMessageTypeCombo" MinWidth="150"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0"
                                  SelectionChanged="SearchFilter_SelectionChanged" />
                        <CalendarDatePicker x:Name="SearchDateFromPicker" PlaceholderText="开始日期"
                                            DateChanged="SearchDate_Changed" />
                        <CalendarDatePicker x:Name="SearchDateToPicker" PlaceholderText="结束日期"
                                            DateChanged="SearchDate_Changed" />
                    </StackPanel>
                </StackPanel>

                <ListView x:Name="SearchResultsList" Grid.Row="2" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="SearchResult_Click">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchHitProxy">
                            <Grid Padding="4,8" RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind PlatformLabel}" FontSize="11"
                                               Foreground="{ThemeResource SystemAccentColor}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Hit.ConversationTitle}"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" FontSize="11" Opacity="0.5" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind Snippet}" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="{x:Bind Hit.SenderName}" FontSize="11" Opacity="0.55" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SearchLoadMore" Content="加载更多" Visibility="Collapsed"
                            Click="OnSearchLoadMoreClick" />
                    <ProgressBar x:Name="SearchProgress" Width="120" IsIndeterminate="True"
                                 Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- 统计面板（Task 14 实现） -->
            <ScrollViewer x:Name="StatsPane" Padding="28" Visibility="Collapsed">
                <TextBlock x:Name="StatsText" FontSize="15" LineHeight="30" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Grid>
    </NavigationView>
    </Grid>
</Window>



