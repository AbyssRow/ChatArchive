<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChatArchive.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatArchive.App.Views"
    xmlns:vm="using:ChatArchive.App.ViewModels"
    Title="聊天档案">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Height="36" Background="Transparent">
            <TextBlock Text="聊天档案" Margin="16,0,0,0"
                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.85" />
        </Grid>

    <NavigationView x:Name="Nav" Grid.Row="1"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    OpenPaneLength="300"
                    SelectionChanged="Nav_SelectionChanged">
        <NavigationView.Resources>
            <local:MsToDateTimeConverter x:Key="MsToDateTime" Format="yyyy-MM-dd HH:mm" />
            <local:PlatformLabelConverter x:Key="PlatformLabel" />
            <local:KindGlyphConverter x:Key="KindGlyph" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />

            <DataTemplate x:Key="ConversationTemplate">
                <Grid Padding="12,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" FontSize="18"
                              Glyph="{Binding Kind, Converter={StaticResource KindGlyph}}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LastMessagePreview}" FontSize="11" Opacity="0.6"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                        <TextBlock FontSize="11" Foreground="{ThemeResource SystemAccentColor}"
                                   Text="{Binding Platform, Converter={StaticResource PlatformLabel}}" />
                        <TextBlock FontSize="10" Opacity="0.5" HorizontalAlignment="Right"
                                   Text="{Binding LastMessageAt, Converter={StaticResource MsToDateTime}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SeparatorTemplate">
                <Border HorizontalAlignment="Center" Padding="12,3" Margin="4,10,4,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.75" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="IncomingTemplate">
                <Grid Margin="8,3" ColumnSpacing="8" MaxWidth="760">
                    <StackPanel Spacing="2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Message.SenderName}" FontSize="11" Opacity="0.55"
                                   Tapped="OnSenderTapped"
                                   Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4,12,12,12" Padding="10,7"
                                HorizontalAlignment="Left">
                            <StackPanel Spacing="6" MaxWidth="560">
                                <TextBlock Text="{Binding Message.Content}" TextWrapping="Wrap"
                                           FontSize="14" IsTextSelectionEnabled="True"
                                           Visibility="{Binding Message.IsRecalled, Converter={StaticResource InverseBool}}" />
                                <TextBlock Text="（已撤回）" FontSize="13" Opacity="0.55"
                                           Visibility="{Binding Message.IsRecalled, Converter={StaticResource BoolToVis}}" FontStyle="Italic" />
                                <Image Source="{Binding ImagePath}" MaxHeight="220" Stretch="Uniform"
                                       Tapped="OnImageTapped" Tag="{Binding}"
                                       Visibility="{Binding ImagePath, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock FontSize="11" Foreground="OrangeRed"
                                           Text="{Binding MissingMediaText}"
                                           Visibility="{Binding HasMissingMedia, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.4" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OutgoingTemplate">
                <Grid Margin="8,3" MaxWidth="760">
                    <StackPanel Spacing="2" HorizontalAlignment="Right">
                        <Border Background="{ThemeResource SystemAccentColorLight2}"
                                CornerRadius="12,4,12,12" Padding="10,7" HorizontalAlignment="Right">
                            <StackPanel Spacing="6" MaxWidth="560">
                                <TextBlock Text="{Binding Message.Content}" TextWrapping="Wrap"
                                           FontSize="14" IsTextSelectionEnabled="True"
                                           Visibility="{Binding Message.IsRecalled, Converter={StaticResource InverseBool}}" />
                                <TextBlock Text="（已撤回）" FontSize="13" Opacity="0.55"
                                           Visibility="{Binding Message.IsRecalled, Converter={StaticResource BoolToVis}}" FontStyle="Italic" />
                                <Image Source="{Binding ImagePath}" MaxHeight="220" Stretch="Uniform"
                                       Tapped="OnImageTapped" Tag="{Binding}"
                                       Visibility="{Binding ImagePath, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.4"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <local:TimelineTemplateSelector x:Key="TimelineSelector"
                                            Separator="{StaticResource SeparatorTemplate}"
                                            Incoming="{StaticResource IncomingTemplate}"
                                            Outgoing="{StaticResource OutgoingTemplate}" />
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="会话" Tag="conversations" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8BD;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="搜索" Tag="search">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="统计" Tag="stats">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Button x:Name="ImportButton" Content="导入聊天记录" Margin="12,8"
                    HorizontalAlignment="Stretch" Click="OnImportClick" />
        </NavigationView.PaneFooter>

        <Grid>
            <!-- 会话面板 -->
            <Grid x:Name="TimelinePane">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="8" Padding="10,10,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ConversationQueryBox" Grid.Row="0" PlaceholderText="查找会话标题…"
                             TextChanged="ConversationQuery_TextChanged" />
                    <ComboBox x:Name="FilterCombo" Grid.Row="1" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="全部" Tag="" />
                        <ComboBoxItem Content="QQ 私聊" Tag="qq|private" />
                        <ComboBoxItem Content="QQ 群聊" Tag="qq|group" />
                        <ComboBoxItem Content="微信私聊" Tag="wechat|private" />
                        <ComboBoxItem Content="微信群聊" Tag="wechat|group" />
                    </ComboBox>
                    <ListView x:Name="ConversationListControl" Grid.Row="2"
                              ItemTemplate="{StaticResource ConversationTemplate}"
                              SelectionMode="Single"
                              SelectionChanged="ConversationList_SelectionChanged" />
                </Grid>

                <Border Grid.Column="1" Width="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Column="2" RowSpacing="6" Padding="8,10,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TimelineTitle" Grid.Row="0" FontSize="17" FontWeight="SemiBold"
                               Margin="4,0,0,4" TextTrimming="CharacterEllipsis" />
                    <ListView x:Name="MessageListControl" Grid.Row="1"
                              ItemTemplateSelector="{StaticResource TimelineSelector}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <ProgressBar x:Name="LoadMoreBar" Grid.Row="2" IsIndeterminate="True"
                                 Height="4" Visibility="Collapsed" Margin="0,4,0,0" />
                </Grid>
            </Grid>

            <!-- 搜索面板 -->
            <Grid x:Name="SearchPane" RowSpacing="10" Padding="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="输入关键词（≥3 字走全文索引，1-2 字自动子串匹配）"
                             KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Content="搜索" Style="{StaticResource AccentButtonStyle}"
                            Click="OnSearchClick" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="SearchPlatformCombo" SelectedIndex="0" MinWidth="110"
                              SelectionChanged="SearchFilter_Changed">
                        <ComboBoxItem Content="全平台" Tag="" />
                        <ComboBoxItem Content="QQ" Tag="qq" />
                        <ComboBoxItem Content="微信" Tag="wechat" />
                    </ComboBox>
                    <ComboBox x:Name="SearchKindCombo" SelectedIndex="0" MinWidth="110"
                              SelectionChanged="SearchFilter_Changed">
                        <ComboBoxItem Content="全部类型" Tag="" />
                        <ComboBoxItem Content="私聊" Tag="private" />
                        <ComboBoxItem Content="群聊" Tag="group" />
                    </ComboBox>
                    <TextBox x:Name="SearchSenderBox" PlaceholderText="发送者（可选）" MinWidth="150"
                             KeyDown="SearchBox_KeyDown" />
                    <TextBlock x:Name="SearchModeLabel" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
                </StackPanel>

                <ListView x:Name="SearchResultsList" Grid.Row="2" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="SearchResult_Click">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchHitProxy">
                            <Grid Padding="4,8" RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind PlatformLabel}" FontSize="11"
                                               Foreground="{ThemeResource SystemAccentColor}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Hit.ConversationTitle}"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" FontSize="11" Opacity="0.5" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind Snippet}" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="{x:Bind Hit.SenderName}" FontSize="11" Opacity="0.55" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SearchLoadMore" Content="加载更多" Visibility="Collapsed"
                            Click="OnSearchLoadMoreClick" />
                    <ProgressBar x:Name="SearchProgress" Width="120" IsIndeterminate="True"
                                 Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- 统计面板（Task 14 实现） -->
            <ScrollViewer x:Name="StatsPane" Padding="28" Visibility="Collapsed">
                <TextBlock x:Name="StatsText" FontSize="15" LineHeight="30" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Grid>
    </NavigationView>
    </Grid>
</Window>



