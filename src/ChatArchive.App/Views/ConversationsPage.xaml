<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChatArchive.App.Views.ConversationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatArchive.App.Views"
    NavigationCacheMode="Required">
    <Page.Resources>
        <DataTemplate x:Key="ConversationTemplate">
            <Grid Padding="12,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" FontSize="18"
                          Glyph="{Binding Kind, Converter={StaticResource KindGlyph}}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastMessagePreview}" FontSize="11" Opacity="0.6"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                    <TextBlock FontSize="11" Foreground="{ThemeResource SystemAccentColor}"
                               Text="{Binding Platform, Converter={StaticResource PlatformLabel}}" />
                    <TextBlock FontSize="10" Opacity="0.5" HorizontalAlignment="Right"
                               Text="{Binding LastMessageAt, Converter={StaticResource MsToDateTime}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SeparatorTemplate">
            <Border HorizontalAlignment="Center" Padding="12,3" Margin="4,10,4,4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10">
                <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.75" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MessageBodyTemplate">
            <StackPanel Spacing="6" MaxWidth="560">
                <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap"
                           FontSize="14" IsTextSelectionEnabled="True"
                           Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="（已撤回）" FontSize="13" Opacity="0.55"
                           Visibility="{Binding Message.IsRecalled, Converter={StaticResource BoolToVis}}"
                           FontStyle="Italic" />
                <ItemsControl ItemsSource="{Binding Images}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="{Binding PreviewAutomationName}"
                                    ToolTipService.ToolTip="{Binding PreviewAutomationName}"
                                    Click="OnImageAttachmentClick">
                                <Image Source="{Binding ResolvedPath, Converter={StaticResource PathToImageSource}}"
                                       MaxHeight="220" Stretch="Uniform" IsHitTestVisible="False" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding OpenableAttachments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding ActionText}" Click="OnAttachmentOpenClick"
                                    HorizontalAlignment="Left" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding MissingAttachments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" Foreground="OrangeRed"
                                       Text="{Binding MissingText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="IncomingTemplate">
            <Grid Margin="8,3" ColumnSpacing="8" MaxWidth="760" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,0,0"
                        Background="Transparent" BorderThickness="0" Padding="0" IsTabStop="False"
                        Visibility="{Binding CanOpenSenderProfile, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AccessibilityView="Raw"
                        Click="OnSenderClick">
                    <PersonPicture Width="32" Height="32" IsHitTestVisible="False" IsTabStop="False"
                                   AutomationProperties.AccessibilityView="Raw"
                                   ProfilePicture="{Binding AvatarPath, Converter={StaticResource PathToImageSource}}"
                                   Initials="{Binding Initials}"
                                   DisplayName="{Binding SenderActionText}" />
                </Button>
                <PersonPicture Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,0,0"
                               IsHitTestVisible="False" IsTabStop="False"
                               Visibility="{Binding CanOpenSenderProfile, Converter={StaticResource InverseBool}}"
                               AutomationProperties.AccessibilityView="Raw"
                               ProfilePicture="{Binding AvatarPath, Converter={StaticResource PathToImageSource}}"
                               Initials="{Binding Initials}"
                               DisplayName="{Binding SenderActionText}" />
                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Left">
                    <Button Content="{Binding SenderActionText}" FontSize="11" Opacity="0.55"
                            HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0"
                            Visibility="{Binding CanOpenSenderProfile, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AccessibilityView="Control"
                            AutomationProperties.Name="{Binding SenderAutomationName}"
                            Click="OnSenderClick" />
                    <TextBlock Text="{Binding SenderActionText}" FontSize="11" Opacity="0.55"
                               HorizontalAlignment="Left"
                               Visibility="{Binding CanOpenSenderProfile, Converter={StaticResource InverseBool}}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4,12,12,12" Padding="10,7"
                            HorizontalAlignment="Left">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource MessageBodyTemplate}" />
                    </Border>
                    <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.4" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OutgoingTemplate">
            <Grid Margin="8,3" ColumnSpacing="8" MaxWidth="760" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Right">
                    <Border Background="{ThemeResource SystemAccentColorLight2}"
                            CornerRadius="12,4,12,12" Padding="10,7" HorizontalAlignment="Right">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource MessageBodyTemplate}" />
                    </Border>
                    <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.4"
                               HorizontalAlignment="Right" />
                </StackPanel>
                <Button Grid.Column="1" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,0,0"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        Visibility="{Binding CanOpenSenderProfile, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AccessibilityView="Control"
                        AutomationProperties.Name="{Binding SenderAutomationName}"
                        Click="OnSenderClick">
                    <PersonPicture Width="32" Height="32" IsHitTestVisible="False" IsTabStop="False"
                                   AutomationProperties.AccessibilityView="Raw"
                                   ProfilePicture="{Binding AvatarPath, Converter={StaticResource PathToImageSource}}"
                                   Initials="{Binding Initials}"
                                   DisplayName="{Binding SenderActionText}" />
                </Button>
                <PersonPicture Grid.Column="1" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,0,0"
                               IsHitTestVisible="False" IsTabStop="False"
                               Visibility="{Binding CanOpenSenderProfile, Converter={StaticResource InverseBool}}"
                               AutomationProperties.AccessibilityView="Raw"
                               ProfilePicture="{Binding AvatarPath, Converter={StaticResource PathToImageSource}}"
                               Initials="{Binding Initials}"
                               DisplayName="{Binding SenderActionText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SystemTemplate">
            <StackPanel Margin="24,6" Spacing="2" HorizontalAlignment="Center">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10" Padding="10,6">
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource MessageBodyTemplate}" />
                </Border>
                <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.4"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <local:TimelineTemplateSelector x:Key="TimelineSelector"
                                        Separator="{StaticResource SeparatorTemplate}"
                                        Incoming="{StaticResource IncomingTemplate}"
                                        Outgoing="{StaticResource OutgoingTemplate}"
                                        System="{StaticResource SystemTemplate}" />
    </Page.Resources>

    <Grid x:Name="TimelinePane">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8" Padding="10,10,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="ConversationQueryBox" Grid.Row="0" PlaceholderText="查找会话标题…"
                     TextChanged="ConversationQuery_TextChanged" />
            <ComboBox x:Name="FilterCombo" Grid.Row="1" SelectedIndex="0" HorizontalAlignment="Stretch"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="全部会话" Tag="" />
                <ComboBoxItem Content="QQ 私聊" Tag="qq|private" />
                <ComboBoxItem Content="QQ 群聊" Tag="qq|group" />
                <ComboBoxItem Content="微信私聊" Tag="wechat|private" />
                <ComboBoxItem Content="微信群聊" Tag="wechat|group" />
                <ComboBoxItem Content="文本 / Markdown" Tag="text|private" />
                <ComboBoxItem Content="网页 / HTML" Tag="html|private" />
                <ComboBoxItem Content="SQL 导出" Tag="sql|private" />
            </ComboBox>
            <ListView x:Name="ConversationListControl" Grid.Row="2"
                      ItemTemplate="{StaticResource ConversationTemplate}"
                      SelectionMode="Single"
                      SelectionChanged="ConversationList_SelectionChanged" />
        </Grid>

        <Border Grid.Column="1" Width="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Column="2" RowSpacing="6" Padding="8,10,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TimelineTitle" Grid.Row="0" FontSize="17" FontWeight="SemiBold"
                       Margin="4,0,0,4" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="LoadMoreBar" Grid.Row="1" IsIndeterminate="True"
                         Height="4" Visibility="Collapsed" Margin="0,0,0,4" />
            <ListView x:Name="MessageListControl" Grid.Row="2"
                      ItemTemplateSelector="{StaticResource TimelineSelector}"
                      SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel VerticalAlignment="Bottom"
                                         ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
